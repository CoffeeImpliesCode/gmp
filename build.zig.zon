// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Fork-authored. `FORK-LICENSE.md` records the owner's authorization of that
// grant for this file; the four `COPYING*` texts in `.paths` are upstream's
// own LGPLv3-or-later and GPLv2-or-later terms, unmodified.
.{
    .name = .gmp,
    .version = "6.3.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x328f6061da525515,
    .license = "LGPL-3.0-or-later OR GPL-2.0-or-later",

    // The upstream GMP 6.3.0 release tree, plus this fork's build, package,
    // test, example and documentation files. Autotools scaffolding, the
    // upstream test suite, the demo and tuning programs and the per CPU
    // assembly directories are kept so the import stays pristine, even though
    // the Zig build compiles none of them. Build output directories are
    // excluded so a normal build never contaminates a package.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "root.zig",
        "include",
        "zig",
        "tools",
        // The runtime-loading route: the reusable loader core, this SDK's half
        // of it, the generator that writes the dispatch from the translated
        // header, the build half that wires them together, and the
        // synchronization binding the dispatch compiles. Every one of those six
        // files is imported or compiled by a step, so a materialised copy has
        // to carry the directory whole.
        "runtime",
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        "mpn",
        "mpz",
        "mpq",
        "mpf",
        "printf",
        "scanf",
        "rand",
        "cxx",
        "demos",
        "doc",
        "mini-gmp",
        "tests",
        "tune",
        "asl.h",
        "AUTHORS",
        "assert.c",
        "bootstrap.c",
        "compat.c",
        "configure",
        "configure.ac",
        "config.in",
        "configfsf.guess",
        "configfsf.sub",
        "config.guess",
        "config.sub",
        "COPYING",
        "COPYING.LESSERv3",
        "COPYINGv2",
        "COPYINGv3",
        "errno.c",
        "extract-dbl.c",
        "gen-bases.c",
        "gen-fac.c",
        "gen-fib.c",
        "gen-jacobitab.c",
        "gen-psqr.c",
        "gen-sieve.c",
        "gen-trialdivtab.c",
        "gmp-h.in",
        "gmp-impl.h",
        "gmp.pc.in",
        "gmpxx.h",
        "gmpxx.pc.in",
        "invalid.c",
        "longlong.h",
        // The build never runs autotools, but `build.zig` derives the shared
        // library's libtool version from `Makefile.am:107-109`, so the file
        // that fixes those numbers travels with the package and that claim
        // stays checkable in a materialised copy.
        "Makefile.am",
        // The autotools scaffolding and helper scripts `UPSTREAM.sha256`
        // records. None of them is compiled and no step reads them, but
        // `tools/provenance_gate.sh` re-verifies every one of the 2156 records
        // with `sha256sum --check` from the package root, so a file the record
        // pins and the package does not carry makes `zig build provenance` fail
        // on a missing file rather than on a changed byte.
        ".gdbinit",
        "ChangeLog",
        "INSTALL",
        "INSTALL.autoconf",
        "Makefile.in",
        "acinclude.m4",
        "aclocal.m4",
        "compile",
        "install-sh",
        "ltmain.sh",
        "missing",
        "test-driver",
        "ylwrap",
        "memory.c",
        "mp_bpl.c",
        "mp_clz_tab.c",
        "mp_dv_tab.c",
        "mp_get_fns.c",
        "mp_minv_tab.c",
        "mp_set_fns.c",
        "nextprime.c",
        "primesieve.c",
        "tal-debug.c",
        "tal-notreent.c",
        "tal-reent.c",
        "version.c",
        "CHANGELOG.md",
        "FORK-LICENSE.md",
        "FORK-NOTES.md",
        "NEWS",
        "NOTICE.md",
        "README",
        "README.md",
        "README.upstream.md",
        "README.zig.md",
        // The per-file record of the pinned archive. The gate reads it before
        // any other check, so a package that does not carry it fails
        // `zig build provenance` on its first check rather than on a
        // divergence; every file it names is in `.paths` for the same reason.
        "UPSTREAM.sha256",
        "UPSTREAM.md",
        // The portable per-SDK derivation and the development environment.
        // They are inputs to a build of this package from outside it, so they
        // belong to its source set.
        "package.nix",
        "flake.nix",
        // The flake's resolved input. `flake.nix` pins nixpkgs by revision and
        // this records what that revision resolved to, so the Nix entry points
        // in a materialised copy build against the input this tree resolves
        // rather than resolving a new one.
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // `.github` and `.gitignore` are this fork's own, and are deliberately
        // not listed: no step of this build graph reads them and the provenance
        // gate does not name them, so carrying them would add bytes without
        // adding a checkable input.
    },
}
