.{
    .name = .gmp,
    .version = "6.3.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x328f6061da525515,
    .license = "LGPL-3.0-or-later OR GPL-2.0-or-later",

    // The upstream GMP 6.3.0 release tree, plus this fork's build, package,
    // test, example and documentation files. Autotools scaffolding, the
    // upstream test suite, the demo and tuning programs and the per CPU
    // assembly directories are kept so the import stays pristine, even though
    // the Zig build compiles none of them. Build output directories are
    // excluded so a normal build never contaminates a package.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "root.zig",
        "include",
        "zig",
        "tools",
        "consumer",
        "mpn",
        "mpz",
        "mpq",
        "mpf",
        "printf",
        "scanf",
        "rand",
        "cxx",
        "demos",
        "doc",
        "mini-gmp",
        "tests",
        "tune",
        "asl.h",
        "AUTHORS",
        "assert.c",
        "bootstrap.c",
        "compat.c",
        "configure",
        "configure.ac",
        "config.in",
        "configfsf.guess",
        "configfsf.sub",
        "config.guess",
        "config.sub",
        "COPYING",
        "COPYING.LESSERv3",
        "COPYINGv2",
        "COPYINGv3",
        "errno.c",
        "extract-dbl.c",
        "gen-bases.c",
        "gen-fac.c",
        "gen-fib.c",
        "gen-jacobitab.c",
        "gen-psqr.c",
        "gen-sieve.c",
        "gen-trialdivtab.c",
        "gmp-h.in",
        "gmp-impl.h",
        "gmp.pc.in",
        "gmpxx.h",
        "gmpxx.pc.in",
        "invalid.c",
        "longlong.h",
        "memory.c",
        "mp_bpl.c",
        "mp_clz_tab.c",
        "mp_dv_tab.c",
        "mp_get_fns.c",
        "mp_minv_tab.c",
        "mp_set_fns.c",
        "nextprime.c",
        "primesieve.c",
        "tal-debug.c",
        "tal-notreent.c",
        "tal-reent.c",
        "version.c",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "NEWS",
        "NOTICE.md",
        "README",
        "README.zig.md",
        "UPSTREAM.md",
    },
}
