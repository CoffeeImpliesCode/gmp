.{
    .name = .gmp_consumer,
    .version = "0.1.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0xf2847ba653057772,
    .license = "LGPL-3.0-or-later OR GPL-2.0-or-later",
    .dependencies = .{
        // The GMP package itself, by relative path. This is what a dependent
        // gets: `b.dependency("gmp", ...)` then `dep.module("gmp")` for the
        // facade plus the full translated C API, or `dep.artifact("gmp")` for
        // the static library with its generated `gmp.h` in the include tree.
        .gmp = .{ .path = ".." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
